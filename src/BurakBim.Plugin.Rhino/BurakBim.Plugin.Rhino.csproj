<Project Sdk="Microsoft.NET.Sdk">
  <!-- BURAK BIM panel for Rhino 7 and later. Built against RhinoCommon 7 (.NET Framework 4.8), which Rhino 8 also loads.
       Rhino has no ribbon, so the tab is a dockable panel. Rhino's own DLLs are only referenced, never shipped. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BurakBim.Rhino</AssemblyName>
    <RootNamespace>BurakBim.Plugin.RhinoTab</RootNamespace>
    <TargetExt>.rhp</TargetExt>
    <Version>1.3.0</Version>
    <Company>BURAK BIM</Company>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>CS0618;NU1701</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="7.38.24338.17001" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="..\..\assets\burakbim.ico" LogicalName="brand.burakbim.ico" />
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
