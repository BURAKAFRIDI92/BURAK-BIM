@@ navis_timeliner_create_tasks
title: TimeLiner: tasks from sets
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Create TimeLiner tasks (Construct) from selection/search sets or from distinct values of a property (e.g. Element/Level), with planned dates spaced by N days.
arg: category | string | Property tab (when creating from property values)
arg: property | string | Property (e.g. Level)
arg: sets | strings | Selection/search set names (alternative)
arg: start | string! | First planned start date (yyyy-MM-dd)
arg: durationDays | integer | Duration of each task (default 7)
arg: taskType | string | Construct (default), Demolish, Temporary
code:
var tl = TimelinerDoc(); var asm = AppDomain.CurrentDomain.GetAssemblies().First(x => x.GetName().Name == "Autodesk.Navisworks.Timeliner");
var start = DateTime.Parse(S("start"), System.Globalization.CultureInfo.InvariantCulture); int dur = I("durationDays", 7); var made = new List<object>();
var sources = new List<KeyValuePair<string, ModelItemCollection>>();
if (SL("sets").Count > 0)
{
    var stack = new Stack<GroupItem>(); stack.Push(doc.SelectionSets.RootItem);
    while (stack.Count > 0) foreach (SavedItem it in stack.Pop().Children) { if (it.IsGroup) stack.Push((GroupItem)it); else if (SL("sets").Contains(it.DisplayName)) sources.Add(new KeyValuePair<string, ModelItemCollection>(it.DisplayName, ((SelectionSet)it).GetSelectedItems())); }
}
else
{
    var values = new SortedSet<string>(); foreach (ModelItem root in doc.Models.RootItems) foreach (ModelItem it in root.DescendantsAndSelf) { var p = it.PropertyCategories.FindPropertyByDisplayName(S("category"), S("property")); if (p != null) values.Add(p.Value.ToDisplayString()); }
    foreach (var v in values) sources.Add(new KeyValuePair<string, ModelItemCollection>(v, Find(S("category"), S("property"), v)));
}
foreach (var src in sources)
{
    dynamic task = Activator.CreateInstance(asm.GetType("Autodesk.Navisworks.Api.Timeliner.TimelinerTask"));
    task.DisplayName = src.Key; task.PlannedStartDate = start; task.PlannedEndDate = start.AddDays(dur); task.SimulationTaskTypeName = S("taskType", "Construct");
    task.Selection.CopyFrom(src.Value);
    tl.TaskAddCopy(task); made.Add(src.Key); start = start.AddDays(dur);
}
return R("tasks", made);

