desc: Current sectioning/clip plane definition (JSON) of the active view.
code:
return R("json", doc.ActiveView.GetClippingPlanes());

@@ navis_selection_sets
title: Selection & search sets
host: navisworks
set: navisworks
tx: false
desc: All selection sets and search sets (folders included) with item counts.
code:
var r = new List<object>(); var stack = new Stack<KeyValuePair<GroupItem, string>>(); stack.Push(new KeyValuePair<GroupItem, string>(doc.SelectionSets.RootItem, ""));
while (stack.Count > 0)
{
    var cur = stack.Pop();
    foreach (SavedItem it in cur.Key.Children)
    {
        var path = cur.Value.Length == 0 ? it.DisplayName : cur.Value + " / " + it.DisplayName;
        if (it.IsGroup) stack.Push(new KeyValuePair<GroupItem, string>((GroupItem)it, path));
        else { var ss = it as SelectionSet; int count = 0; try { count = ss.GetSelectedItems().Count; } catch { } r.Add(R("name", path, "kind", ss != null && ss.HasSearch ? "search set" : "selection set", "items", count)); }
    }
}
return r;

@@ navis_selection_set_create
title: Create selection / search set
host: navisworks
set: navisworks
tx: false
desc: Save the current selection (or handles) as a selection set, or a property search as a dynamic search set.
arg: name | string! | Set name
arg: search | object | Make a search set from {category, property, value, op}
arg: handles | strings | Items for a selection set (omit = current selection)
code:
SelectionSet set;
if (Has("search"))
{
    var o = O("search"); var s = new Search(); s.Selection.SelectAll(); s.Locations = SearchLocations.DescendantsAndSelf;
    var c = SearchCondition.HasPropertyByDisplayName(BurakBim.Shared.Json.Str(o, "category"), BurakBim.Shared.Json.Str(o, "property"));
    var v = BurakBim.Shared.Json.Str(o, "value");
    if (v != null) c = (BurakBim.Shared.Json.Str(o, "op", "equals") == "contains" ? c.DisplayStringContains(v) : c.EqualValue(VariantData.FromDisplayString(v))).IgnoreStringValueCase();
    s.SearchConditions.Add(c); set = new SelectionSet(s);
}
else set = new SelectionSet((ModelItemCollection)Items());
set.DisplayName = S("name"); doc.SelectionSets.AddCopy(set);
return R("created", S("name"), "kind", Has("search") ? "search set" : "selection set");

@@ navis_selection_set_apply
title: Select a set
host: navisworks
set: navisworks
tx: false
desc: Select the items of a saved selection/search set (by name), optionally hide everything else.
arg: name | string! | Set name
arg: isolate | boolean | Hide unselected
code:
SelectionSet found = null; var stack = new Stack<GroupItem>(); stack.Push(doc.SelectionSets.RootItem);
while (stack.Count > 0 && found == null) foreach (SavedItem it in stack.Pop().Children) { if (it.IsGroup) stack.Push((GroupItem)it); else if (it.DisplayName == S("name")) found = it as SelectionSet; }
if (found == null) Fail("Set not found");
var items = found.GetSelectedItems(); doc.CurrentSelection.CopyFrom(items);
if (B("isolate"))
{
    var keep = new ModelItemCollection(); foreach (ModelItem i in items) { keep.AddRange(i.AncestorsAndSelf); keep.AddRange(i.Descendants); }
    var hide = new ModelItemCollection(); foreach (ModelItem i in keep) if (i.Parent != null) foreach (ModelItem sib in i.Parent.Children) if (!keep.Contains(sib)) hide.Add(sib);
    doc.Models.ResetAllHidden(); doc.Models.SetHidden(hide, true);
}
return R("selected", items.Count);

@@ navis_sets_by_property
title: Search sets for every value
host: navisworks
set: navisworks
tx: false
desc: Create one search set per distinct value of a property (e.g. a set per Revit Category or per Level) inside a folder - the classic clash-matrix setup in one call.
arg: category | string! | Property tab, e.g. Element
arg: property | string! | Property, e.g. Category
arg: folder | string | Folder name (default "BURAK BIM - <property>")
code:
var values = new HashSet<string>();
foreach (ModelItem root in doc.Models.RootItems) foreach (ModelItem it in root.DescendantsAndSelf) { var p = it.PropertyCategories.FindPropertyByDisplayName(S("category"), S("property")); if (p != null) values.Add(p.Value.ToDisplayString()); }
var fname = S("folder", "BURAK BIM - " + S("property")); doc.SelectionSets.AddCopy(new FolderItem { DisplayName = fname });
GroupItem folder = null; foreach (SavedItem it in doc.SelectionSets.RootItem.Children) if (it.IsGroup && it.DisplayName == fname) folder = (GroupItem)it;
foreach (var v in values.OrderBy(x => x))
{
    var s = new Search(); s.Selection.SelectAll(); s.Locations = SearchLocations.DescendantsAndSelf;
    s.SearchConditions.Add(SearchCondition.HasPropertyByDisplayName(S("category"), S("property")).EqualValue(VariantData.FromDisplayString(v)));
    var set = new SelectionSet(s) { DisplayName = v }; doc.SelectionSets.InsertCopy(folder, folder.Children.Count, set);
}
return R("folder", fname, "sets", values.Count);

@@ navis_clash_matrix
title: Clash matrix (create tests)
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Create a hard-clash test for every pair of property values (e.g. Element/Category: Structural Framing x Ducts, Pipes, Cable Trays) and optionally run them.
arg: category | string! | Property tab (e.g. Element)
arg: property | string! | Property (e.g. Category)
arg: groupA | strings! | Values for side A
arg: groupB | strings! | Values for side B
arg: tolerance | number | Tolerance in model units (default 0)
arg: type | string | Hard (default), HardConservative, Clearance
arg: run | boolean | Run the tests (default true)
code:
var data = ClashDoc().TestsData; var made = new List<object>();
foreach (var a in SL("groupA")) foreach (var b in SL("groupB"))
{
    if (a == b) continue;
    dynamic test = Activator.CreateInstance(AppDomain.CurrentDomain.GetAssemblies().First(x => x.GetName().Name == "Autodesk.Navisworks.Clash").GetType("Autodesk.Navisworks.Api.Clash.ClashTest"));
    test.DisplayName = a + " vs " + b;
    test.TestType = (dynamic)Enum.Parse(test.TestType.GetType(), S("type", "Hard"), true);
    test.Tolerance = N("tolerance", 0);
    test.SelectionA.Selection.CopyFrom(Find(S("category"), S("property"), a));
    test.SelectionB.Selection.CopyFrom(Find(S("category"), S("property"), b));
    data.TestsAddCopy(test); made.Add(a + " vs " + b);
}
if (B("run", true)) data.TestsRunAllTests();
return R("tests", made);

@@ navis_clash_summary
title: Clash summary dashboard
host: navisworks
set: navisworks
tx: false
desc: Every clash test with totals by status (New/Active/Reviewed/Approved/Resolved) plus grand totals - coordination meeting summary.
code:
var totals = new Dictionary<string, int>(); var tests = new List<object>();
foreach (dynamic t in ClashDoc().TestsData.Tests)
{
    var counts = new Dictionary<string, object>(); int n = 0;
    foreach (dynamic c in t.Children)
    {
        var list = new List<dynamic>(); if ((bool)c.IsGroup) foreach (dynamic r in c.Children) list.Add(r); else list.Add(c);
        foreach (var r in list) { string s = r.Status.ToString(); counts[s] = (counts.ContainsKey(s) ? (int)counts[s] : 0) + 1; totals[s] = (totals.ContainsKey(s) ? totals[s] : 0) + 1; n++; }
    }
    tests.Add(R("test", (string)t.DisplayName, "type", t.TestType.ToString(), "total", n, "byStatus", counts));
}
return R("totals", totals.ToDictionary(k => k.Key, k => (object)k.Value), "tests", tests);

@@ navis_clash_group_by_level
title: Group clashes by level / grid
host: navisworks
set: navisworks
tx: false
desc: Report clash results of a test bucketed by a property of item 1 (e.g. Element/Level) - where are the problems.
arg: test | string! | Clash test
arg: category | string | Property tab (default Element)
arg: property | string | Property (default Level)
code:
var res = new Dictionary<string, int>();
foreach (dynamic c in Test(S("test")).Children)
{
    var list = new List<dynamic>(); if ((bool)c.IsGroup) foreach (dynamic r in c.Children) list.Add(r); else list.Add(c);
    foreach (var r in list)
    {
        string key = "(unknown)";
        try { ModelItem i1 = r.Item1; var p = i1 == null ? null : (i1.PropertyCategories.FindPropertyByDisplayName(S("category", "Element"), S("property", "Level")) ?? (i1.Parent == null ? null : i1.Parent.PropertyCategories.FindPropertyByDisplayName(S("category", "Element"), S("property", "Level")))); if (p != null) key = p.Value.ToDisplayString(); } catch { }
        res[key] = res.ContainsKey(key) ? res[key] + 1 : 1;
    }
}
return res.OrderByDescending(k => k.Value).ToDictionary(k => k.Key, k => (object)k.Value);

@@ navis_clash_viewpoint
title: Zoom to a clash
host: navisworks
set: navisworks
tx: false
desc: Select both items of a clash result, color them red/green, zoom to it and optionally save a viewpoint named after the clash.
arg: result | string! | Clash result handle (from navisworks_clash_results)
arg: save | boolean | Save a viewpoint
code:
dynamic r = FromHandle(S("result")); var items = new ModelItemCollection();
ModelItem a = r.Item1; ModelItem b = r.Item2; if (a != null) items.Add(a); if (b != null) items.Add(b);
doc.CurrentSelection.CopyFrom(items);
if (a != null) doc.Models.OverrideTemporaryColor(new ModelItemCollection { a }, new Color(1, 0, 0));
if (b != null) doc.Models.OverrideTemporaryColor(new ModelItemCollection { b }, new Color(0, 0.8, 0));
var vp = doc.CurrentViewpoint.CreateCopy(); vp.ZoomBox(items.BoundingBox()); doc.CurrentViewpoint.CopyFrom(vp);
if (B("save")) { var sv = new SavedViewpoint(doc.CurrentViewpoint.CreateCopy()); sv.DisplayName = "Clash - " + (string)r.DisplayName; doc.SavedViewpoints.AddCopy(sv); }
return R("clash", (string)r.DisplayName, "distance", (double)r.Distance);

@@ navis_clash_auto_group
title: Group clashes by item
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Group the results of a test by their first item's parent (e.g. one group per beam/duct) to reduce hundreds of clashes to actionable issues.
arg: test | string! | Clash test
code:
var data = ClashDoc().TestsData; dynamic test = Test(S("test"));
var clashAsm = AppDomain.CurrentDomain.GetAssemblies().First(x => x.GetName().Name == "Autodesk.Navisworks.Clash");
var groups = new Dictionary<string, List<dynamic>>();
foreach (dynamic c in test.Children) { if ((bool)c.IsGroup) continue; ModelItem i1 = c.Item1; var key = i1 == null ? "(none)" : (i1.Parent != null ? i1.Parent.DisplayName : i1.DisplayName); if (!groups.ContainsKey(key)) groups[key] = new List<dynamic>(); groups[key].Add(c); }
dynamic copy = test.CreateCopy(); copy.Children.Clear();
foreach (var kv in groups)
{
    if (kv.Value.Count == 1) { copy.Children.Add(kv.Value[0].CreateCopy()); continue; }
    dynamic g = Activator.CreateInstance(clashAsm.GetType("Autodesk.Navisworks.Api.Clash.ClashResultGroup")); g.DisplayName = kv.Key;
    foreach (var c in kv.Value) g.Children.Add(c.CreateCopy());
    copy.Children.Add(g);
}
data.TestsEditTestFromCopy(test, copy);
return R("groups", groups.Count(k => k.Value.Count > 1), "ungrouped", groups.Count(k => k.Value.Count == 1));

@@ navis_clash_bulk_status
title: Bulk clash status
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Set the status (and assignee) of all results of a test that match a current status - e.g. mark all New as Active, all Approved as Resolved.
arg: test | string! | Clash test
arg: fromStatus | string | Only results with this status
arg: toStatus | string! | New status: New, Active, Reviewed, Approved, Resolved
arg: assignedTo | string | Assign to
code:
var data = ClashDoc().TestsData; int n = 0; dynamic test = Test(S("test"));
var statusType = AppDomain.CurrentDomain.GetAssemblies().First(x => x.GetName().Name == "Autodesk.Navisworks.Clash").GetType("Autodesk.Navisworks.Api.Clash.ClashResultStatus");
var to = Enum.Parse(statusType, S("toStatus"), true);
var all = new List<dynamic>(); foreach (dynamic c in test.Children) { if ((bool)c.IsGroup) foreach (dynamic r in c.Children) all.Add(r); else all.Add(c); }
foreach (var r in all)
{
    if (Has("fromStatus") && !string.Equals((string)r.Status.ToString(), S("fromStatus"), StringComparison.OrdinalIgnoreCase)) continue;
    data.TestsEditResultStatus(r, (dynamic)to); if (Has("assignedTo")) data.TestsEditResultAssignedTo(r, S("assignedTo")); n++;
}
return R("updated", n);

@@ navis_clash_report_csv
title: Clash report (CSV)
host: navisworks
set: navisworks
tx: false
desc: Write a CSV clash report (test, clash, status, distance mm, location, item paths, assignee) for one or all tests.
arg: test | string | Test name (default all)
arg: path | string | Output .csv
code:
var sb = new System.Text.StringBuilder("Test,Clash,Status,Distance mm,X,Y,Z,Item 1,Item 2,Assigned To,Created\n");
foreach (dynamic t in ClashDoc().TestsData.Tests)
{
    if (Has("test") && (string)t.DisplayName != S("test")) continue;
    var all = new List<dynamic>(); foreach (dynamic c in t.Children) { if ((bool)c.IsGroup) foreach (dynamic r in c.Children) all.Add(r); else all.Add(c); }
    foreach (var r in all)
    {
        string i1 = "", i2 = ""; try { i1 = PathOf(r.Item1); i2 = PathOf(r.Item2); } catch { }
        Point3D p = r.Center;
        sb.AppendLine(string.Join(",", new[] { (string)t.DisplayName, (string)r.DisplayName, r.Status.ToString(), Math.Round((double)r.Distance * ToMm, 1).ToString(System.Globalization.CultureInfo.InvariantCulture),
            p.X.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture), p.Y.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture), p.Z.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture), i1, i2, (string)r.AssignedTo ?? "", Convert.ToString(r.CreatedTime) }.Select(x => "\"" + (x ?? "").Replace("\"", "'") + "\"")));
    }
}
var path = S("path") ?? System.IO.Path.Combine(BurakBim.Shared.BurakPaths.Sub("exports", "navisworks"), "Clash-Report-" + DateTime.Now.ToString("yyyyMMdd-HHmm") + ".csv");
System.IO.File.WriteAllText(path, sb.ToString()); return R("report", path);

@@ navis_clash_report_html
title: Clash report (HTML with images)
host: navisworks
set: navisworks
tx: false
readonly: false
desc: HTML clash report with a rendered image per clash (first N results of a test) - send to designers.
arg: test | string! | Test
arg: status | string | Only this status (default New)
arg: limit | integer | Max clashes (default 30)
code:
var folder = BurakBim.Shared.BurakPaths.Sub("reports", "clash-" + DateTime.Now.ToString("yyyyMMdd-HHmm")); var sb = new System.Text.StringBuilder();
sb.Append("<html><head><meta charset='utf-8'><title>Clash report</title><style>body{font-family:Segoe UI,Arial}td{vertical-align:top;padding:6px;border-bottom:1px solid #ddd}</style></head><body><h1>BURAK BIM clash report - " + S("test") + "</h1><table>");
var all = new List<dynamic>(); foreach (dynamic c in Test(S("test")).Children) { if ((bool)c.IsGroup) foreach (dynamic r in c.Children) all.Add(r); else all.Add(c); }
int n = 0;
foreach (var r in all)
{
    if (r.Status.ToString() != S("status", "New")) continue; if (n++ >= I("limit", 30)) break;
    var items = new ModelItemCollection(); ModelItem a = r.Item1; ModelItem b = r.Item2; if (a != null) items.Add(a); if (b != null) items.Add(b);
    doc.CurrentSelection.CopyFrom(items); var vp = doc.CurrentViewpoint.CreateCopy(); vp.ZoomBox(items.BoundingBox()); doc.CurrentViewpoint.CopyFrom(vp);
    var img = "clash" + n + ".png"; doc.ActiveView.GenerateImage(ImageGenerationStyle.ScenePlusOverlay, 800, 500).Save(System.IO.Path.Combine(folder, img), System.Drawing.Imaging.ImageFormat.Png);
    sb.Append("<tr><td><img src='" + img + "' width='400'></td><td><b>" + (string)r.DisplayName + "</b><br>Distance: " + Math.Round((double)r.Distance * ToMm, 1) + " mm<br>" + System.Net.WebUtility.HtmlEncode(a == null ? "" : PathOf(a)) + "<br>vs<br>" + System.Net.WebUtility.HtmlEncode(b == null ? "" : PathOf(b)) + "</td></tr>");
}
sb.Append("</table></body></html>"); var file = System.IO.Path.Combine(folder, "index.html"); System.IO.File.WriteAllText(file, sb.ToString());
return R("report", file, "clashes", n);

@@ navis_clash_delete_tests
title: Delete clash tests
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Delete clash tests by name, or all tests (clear).
arg: tests | strings | Test names
arg: all | boolean | Delete every test
code:
var data = ClashDoc().TestsData;
if (B("all")) { data.TestsClear(); return R("cleared", true); }
var del = new List<dynamic>(); foreach (dynamic t in data.Tests) if (SL("tests").Contains((string)t.DisplayName)) del.Add(t);
foreach (var t in del) data.TestsRemove(t);
return R("deleted", del.Count);

