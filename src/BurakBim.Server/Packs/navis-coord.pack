# BURAK BIM tool pack - Navisworks coordination: viewpoints, cameras, sections, images, selection/search sets, clash detective, TimeLiner, reports

@@ navis_viewpoint_zoom
title: Zoom to items
host: navisworks
set: navisworks
tx: false
desc: Zoom the current view to items (handles, search or selection), optionally saving it as a viewpoint.
arg: handles | strings | Items (omit = selection)
arg: search | object | Or a property search
arg: saveAs | string | Save the result as a viewpoint
code:
ModelItemCollection items = Items(); var bb = items.BoundingBox();
var vp = doc.CurrentViewpoint.CreateCopy(); vp.ZoomBox(bb); doc.CurrentViewpoint.CopyFrom(vp);
if (Has("saveAs")) { var sv = new SavedViewpoint(doc.CurrentViewpoint.CreateCopy()); sv.DisplayName = S("saveAs"); doc.SavedViewpoints.AddCopy(sv); }
return R("zoomed", items.Count);

@@ navis_camera
title: Get / set camera
host: navisworks
set: navisworks
tx: false
desc: Read the camera (position, look-at, projection, field of view) or set position + target (model units) and projection.
arg: position | point | Eye position
arg: target | point | Look-at point
arg: projection | string | Perspective or Orthographic
code:
var vp = doc.CurrentViewpoint.CreateCopy();
if (Has("position")) { var p = BurakBim.Shared.Json.Vec(Raw("position")); vp.Position = new Point3D(p[0], p[1], p[2]); }
if (Has("target")) { var t = BurakBim.Shared.Json.Vec(Raw("target")); vp.PointAt(new Point3D(t[0], t[1], t[2])); }
if (Has("projection")) vp.Projection = S("projection").StartsWith("O", StringComparison.OrdinalIgnoreCase) ? ViewpointProjection.Orthographic : ViewpointProjection.Perspective;
if (Has("position") || Has("target") || Has("projection")) doc.CurrentViewpoint.CopyFrom(vp);
var cur = doc.CurrentViewpoint.Value;
return R("position", new List<object> { cur.Position.X, cur.Position.Y, cur.Position.Z }, "projection", cur.Projection.ToString(), "focalDistance", cur.FocalDistance);

@@ navis_viewpoints_tree
title: Saved viewpoints (with folders & comments)
host: navisworks
set: navisworks
tx: false
desc: Every saved viewpoint and folder with comment counts and redline presence.
code:
var r = new List<object>(); var stack = new Stack<KeyValuePair<GroupItem, string>>(); stack.Push(new KeyValuePair<GroupItem, string>(doc.SavedViewpoints.RootItem, ""));
while (stack.Count > 0)
{
    var cur = stack.Pop();
    foreach (SavedItem it in cur.Key.Children)
    {
        var path = cur.Value.Length == 0 ? it.DisplayName : cur.Value + " / " + it.DisplayName;
        if (it.IsGroup) { r.Add(R("folder", path)); stack.Push(new KeyValuePair<GroupItem, string>((GroupItem)it, path)); }
        else r.Add(R("viewpoint", path, "comments", it.Comments.Count, "guid", it.Guid.ToString()));
    }
}
return r;

@@ navis_viewpoint_folder
title: Viewpoint folder & organise
host: navisworks
set: navisworks
tx: false
desc: Create a viewpoint folder and optionally move/copy named viewpoints into it.
arg: folder | string! | Folder name
arg: viewpoints | strings | Viewpoint names to copy into the folder
code:
var folder = new FolderItem { DisplayName = S("folder") }; doc.SavedViewpoints.AddCopy(folder);
GroupItem target = null; foreach (SavedItem it in doc.SavedViewpoints.RootItem.Children) if (it.IsGroup && it.DisplayName == S("folder")) target = (GroupItem)it;
int n = 0;
foreach (var name in SL("viewpoints"))
  foreach (SavedItem it in doc.SavedViewpoints.RootItem.Children) if (!it.IsGroup && it.DisplayName == name) { doc.SavedViewpoints.InsertCopy(target, target.Children.Count, it); n++; }
return R("folder", S("folder"), "copied", n);

@@ navis_viewpoint_delete
title: Delete viewpoints
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Delete saved viewpoints by name (or all whose name starts with a prefix).
arg: names | strings | Names
arg: prefix | string | Name prefix
code:
var del = new List<SavedItem>();
foreach (SavedItem it in doc.SavedViewpoints.RootItem.Children) if (!it.IsGroup && (SL("names").Contains(it.DisplayName) || (Has("prefix") && it.DisplayName.StartsWith(S("prefix"))))) del.Add(it);
foreach (var it in del) doc.SavedViewpoints.Remove(doc.SavedViewpoints.RootItem, it);
return R("deleted", del.Count);

@@ navis_viewpoint_rename
title: Rename viewpoint
host: navisworks
set: navisworks
tx: false
desc: Rename a saved viewpoint.
arg: name | string! | Current name
arg: newName | string! | New name
code:
foreach (SavedItem it in doc.SavedViewpoints.RootItem.Children) if (it.DisplayName == S("name")) { doc.SavedViewpoints.EditDisplayName(it, S("newName")); return R("renamed", S("newName")); }
Fail("Viewpoint not found"); return null;

@@ navis_image_export
title: Export view image
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Render the current view (or a saved viewpoint) to a PNG file at a resolution.
arg: viewpoint | string | Saved viewpoint to apply first
arg: width | integer | Width px (default 1920)
arg: height | integer | Height px (default 1080)
arg: path | string | Output .png (default exports folder)
code:
if (Has("viewpoint")) foreach (SavedItem it in doc.SavedViewpoints.RootItem.Children) if (it.DisplayName == S("viewpoint")) doc.SavedViewpoints.CurrentSavedViewpoint = (SavedViewpoint)it;
var bmp = doc.ActiveView.GenerateImage(ImageGenerationStyle.ScenePlusOverlay, I("width", 1920), I("height", 1080));
var path = S("path") ?? System.IO.Path.Combine(BurakBim.Shared.BurakPaths.Sub("exports", "navisworks"), "view-" + DateTime.Now.ToString("yyyyMMdd-HHmmss") + ".png");
bmp.Save(path, System.Drawing.Imaging.ImageFormat.Png);
return R("image", path);

@@ navis_viewpoint_images
title: Export images of all viewpoints
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Export a PNG for every saved viewpoint (top level) - fast coordination report material.
arg: width | integer | Width (default 1600)
arg: height | integer | Height (default 900)
arg: folder | string | Output folder
code:
var folder = S("folder") ?? BurakBim.Shared.BurakPaths.Sub("exports", "navisworks", "viewpoints"); System.IO.Directory.CreateDirectory(folder); var files = new List<object>();
foreach (SavedItem it in doc.SavedViewpoints.RootItem.Children)
{
    var sv = it as SavedViewpoint; if (sv == null) continue; doc.SavedViewpoints.CurrentSavedViewpoint = sv;
    var bmp = doc.ActiveView.GenerateImage(ImageGenerationStyle.ScenePlusOverlay, I("width", 1600), I("height", 900));
    var f = System.IO.Path.Combine(folder, string.Concat(sv.DisplayName.Split(System.IO.Path.GetInvalidFileNameChars())) + ".png"); bmp.Save(f, System.Drawing.Imaging.ImageFormat.Png); files.Add(f);
}
return R("folder", folder, "images", files);

@@ navis_section_box
title: Sectioning (box / clip planes)
host: navisworks
set: navisworks
tx: false
desc: Enable sectioning as a box around items (or a box in model units), or turn sectioning off. Uses the view clipping-planes JSON API (Navisworks 2017+).
arg: handles | strings | Items to box (omit = selection)
arg: min | point | Box min (instead of items)
arg: max | point | Box max
arg: off | boolean | Turn sectioning off
arg: marginPercent | number | Margin (default 10)
code:
if (B("off")) { doc.ActiveView.SetClippingPlanes("{\"Type\":\"ClipPlaneSet\",\"Version\":1,\"OrientedBox\":{\"Type\":\"OrientedBox3D\",\"Version\":1,\"Box\":[[0,0,0],[0,0,0]],\"Rotation\":[0,0,0]},\"Enabled\":false}"); return R("sectioning", false); }
BoundingBox3D bb;
if (Has("min")) { var a = BurakBim.Shared.Json.Vec(Raw("min")); var b = BurakBim.Shared.Json.Vec(Raw("max")); bb = new BoundingBox3D(new Point3D(a[0], a[1], a[2]), new Point3D(b[0], b[1], b[2])); }
else bb = ((ModelItemCollection)Items()).BoundingBox();
var m = N("marginPercent", 10) / 100.0; var dx = bb.Size.X * m; var dy = bb.Size.Y * m; var dz = bb.Size.Z * m;
var inv = System.Globalization.CultureInfo.InvariantCulture;
var json = string.Format(inv, "{{\"Type\":\"ClipPlaneSet\",\"Version\":1,\"OrientedBox\":{{\"Type\":\"OrientedBox3D\",\"Version\":1,\"Box\":[[{0},{1},{2}],[{3},{4},{5}]],\"Rotation\":[0,0,0]}},\"Enabled\":true}}", bb.Min.X - dx, bb.Min.Y - dy, bb.Min.Z - dz, bb.Max.X + dx, bb.Max.Y + dy, bb.Max.Z + dz);
doc.ActiveView.SetClippingPlanes(json);
return R("sectioning", true, "json", json);

@@ navis_clip_planes_get
title: Read clip planes
host: navisworks
