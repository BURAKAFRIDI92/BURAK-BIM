# BURAK BIM tool pack - Revit MEP: systems, pipes, ducts, fittings, insulation, electrical, spaces

@@ revit_mep_systems_report
title: MEP systems report
host: revit
tx: false
desc: Piping, duct and electrical systems with classification, element counts and base equipment.
code:
return All<MEPSystem>().Select(s => (object)R("id", IdOf(s), "name", s.Name, "class", s.GetType().Name, "type", Name(s.GetTypeId()),
   "elements", s.Elements == null ? 0 : s.Elements.Size, "baseEquipment", s.BaseEquipment == null ? null : s.BaseEquipment.Name)).ToList();

@@ revit_pipes_report
title: Pipes report
host: revit
tx: false
desc: Pipes with system, type, diameter (mm), length (m), slope and level; totals by system and diameter.
code:
var pipes = All<Pipe>().ToList();
Func<Pipe, string> sys = p => { var s = p.MEPSystem; return s == null ? "(none)" : s.Name; };
return R("count", pipes.Count,
  "lengthBySystemM", pipes.GroupBy(sys).ToDictionary(g => g.Key, g => (object)Math.Round(g.Sum(p => p.get_Parameter(BuiltInParameter.CURVE_ELEM_LENGTH).AsDouble()) * 0.3048, 2)),
  "lengthByDiameterM", pipes.GroupBy(p => Mm(p.Diameter).ToString() + " mm").ToDictionary(g => g.Key, g => (object)Math.Round(g.Sum(p => p.get_Parameter(BuiltInParameter.CURVE_ELEM_LENGTH).AsDouble()) * 0.3048, 2)),
  "pipes", pipes.Take(1500).Select(p => (object)R("id", IdOf(p), "system", sys(p), "type", p.PipeType.Name, "diameterMm", Mm(p.Diameter),
      "lengthMm", Mm(p.get_Parameter(BuiltInParameter.CURVE_ELEM_LENGTH).AsDouble()), "slope", p.get_Parameter(BuiltInParameter.RBS_PIPE_SLOPE) == null ? null : p.get_Parameter(BuiltInParameter.RBS_PIPE_SLOPE).AsValueString(), "level", Name(p.ReferenceLevel.Id))).ToList());

@@ revit_ducts_report
title: Ducts report
host: revit
tx: false
desc: Ducts with system, type, size, length and level; totals by system.
code:
var ducts = All<Duct>().ToList();
Func<Duct, string> sys = d => d.MEPSystem == null ? "(none)" : d.MEPSystem.Name;
return R("count", ducts.Count,
  "lengthBySystemM", ducts.GroupBy(sys).ToDictionary(g => g.Key, g => (object)Math.Round(g.Sum(d => d.get_Parameter(BuiltInParameter.CURVE_ELEM_LENGTH).AsDouble()) * 0.3048, 2)),
  "ducts", ducts.Take(1500).Select(d => (object)R("id", IdOf(d), "system", sys(d), "type", d.DuctType.Name, "size", d.get_Parameter(BuiltInParameter.RBS_CALCULATED_SIZE) == null ? null : d.get_Parameter(BuiltInParameter.RBS_CALCULATED_SIZE).AsString(),
      "lengthMm", Mm(d.get_Parameter(BuiltInParameter.CURVE_ELEM_LENGTH).AsDouble()), "level", Name(d.ReferenceLevel.Id))).ToList());

@@ revit_pipe_route
title: Route pipes through points
host: revit
desc: Create a connected pipe run through points (mm) with elbows at every bend (uses the pipe type's routing preferences).
arg: points | array! | [[x,y,z],...] at least 2
arg: system | string | Piping system type (default first)
arg: type | string | Pipe type
arg: diameterMm | number | Diameter
arg: level | string | Reference level
code:
var pts = A("points").Select(p => Pt(p)).ToList();
var pt = TypeByName<PipeType>(S("type")); var st = TypeByName<PipingSystemType>(S("system"));
var lv = Has("level") ? LvlArg() : Levels().Where(l => l.Elevation <= pts.Min(p => p.Z) + 1e-6).DefaultIfEmpty(Levels().First()).Last();
var pipes = new List<Pipe>();
for (int i = 0; i + 1 < pts.Count; i++)
{
    var p = Pipe.Create(doc, st.Id, pt.Id, lv.Id, pts[i], pts[i + 1]);
    if (Has("diameterMm")) p.get_Parameter(BuiltInParameter.RBS_PIPE_DIAMETER_PARAM).Set(Ft(N("diameterMm")));
    pipes.Add(p);
}
doc.Regenerate(); var fittings = new List<object>();
for (int i = 0; i + 1 < pipes.Count; i++)
{
    Connector c1 = null, c2 = null; double best = double.MaxValue;
    foreach (Connector a in pipes[i].ConnectorManager.Connectors) foreach (Connector b in pipes[i + 1].ConnectorManager.Connectors)
        { var d = a.Origin.DistanceTo(b.Origin); if (d < best) { best = d; c1 = a; c2 = b; } }
    try { fittings.Add(IdOf(doc.Create.NewElbowFitting(c1, c2))); } catch (Exception ex) { Print("elbow " + i + ": " + ex.Message); }
}
return R("pipes", IdList(pipes), "fittings", fittings);

@@ revit_duct_route
title: Route ducts through points
host: revit
desc: Create a connected duct run through points (mm) with elbows at bends.
arg: points | array! | [[x,y,z],...]
arg: system | string | Mechanical system type
arg: type | string | Duct type
arg: widthMm | number | Width (rectangular)
arg: heightMm | number | Height (rectangular)
arg: diameterMm | number | Diameter (round)
arg: level | string | Reference level
code:
var pts = A("points").Select(p => Pt(p)).ToList();
var dt = TypeByName<DuctType>(S("type")); var st = TypeByName<MechanicalSystemType>(S("system"));
var lv = Has("level") ? LvlArg() : Levels().Where(l => l.Elevation <= pts.Min(p => p.Z) + 1e-6).DefaultIfEmpty(Levels().First()).Last();
var ducts = new List<Duct>();
for (int i = 0; i + 1 < pts.Count; i++)
{
    var d = Duct.Create(doc, st.Id, dt.Id, lv.Id, pts[i], pts[i + 1]);
    if (Has("widthMm")) { var p = d.get_Parameter(BuiltInParameter.RBS_CURVE_WIDTH_PARAM); if (p != null) p.Set(Ft(N("widthMm"))); }
    if (Has("heightMm")) { var p = d.get_Parameter(BuiltInParameter.RBS_CURVE_HEIGHT_PARAM); if (p != null) p.Set(Ft(N("heightMm"))); }
    if (Has("diameterMm")) { var p = d.get_Parameter(BuiltInParameter.RBS_CURVE_DIAMETER_PARAM); if (p != null) p.Set(Ft(N("diameterMm"))); }
    ducts.Add(d);
}
doc.Regenerate(); var fit = new List<object>();
for (int i = 0; i + 1 < ducts.Count; i++)
{
    Connector c1 = null, c2 = null; double best = double.MaxValue;
    foreach (Connector a in ducts[i].ConnectorManager.Connectors) foreach (Connector b in ducts[i + 1].ConnectorManager.Connectors)
        { var dd = a.Origin.DistanceTo(b.Origin); if (dd < best) { best = dd; c1 = a; c2 = b; } }
    try { fit.Add(IdOf(doc.Create.NewElbowFitting(c1, c2))); } catch (Exception ex) { Print("elbow " + i + ": " + ex.Message); }
}
return R("ducts", IdList(ducts), "fittings", fit);

@@ revit_mep_connect
title: Connect two MEP curves
host: revit
desc: Connect the nearest open ends of two pipes/ducts/trays/conduits with an elbow (or direct connection when aligned).
arg: a | integer! | First element
arg: b | integer! | Second element
code:
var ea = El(I("a")) as MEPCurve; var eb = El(I("b")) as MEPCurve; if (ea == null || eb == null) Fail("Both must be pipes/ducts/trays/conduits");
Connector c1 = null, c2 = null; double best = double.MaxValue;
foreach (Connector x in ea.ConnectorManager.Connectors) foreach (Connector y in eb.ConnectorManager.Connectors)
  { if (x.IsConnected || y.IsConnected) continue; var d = x.Origin.DistanceTo(y.Origin); if (d < best) { best = d; c1 = x; c2 = y; } }
if (c1 == null) Fail("No open connectors");
if (best < 1e-3) { c1.ConnectTo(c2); return R("connected", "direct"); }
return R("fitting", IdOf(doc.Create.NewElbowFitting(c1, c2)));

@@ revit_mep_tee
title: Tee between three MEP curves
host: revit
desc: Create a tee fitting joining a branch into a main split at the same point (main1, main2, branch ids).
arg: main1 | integer! | Main segment 1
arg: main2 | integer! | Main segment 2
arg: branch | integer! | Branch
code:
Func<MEPCurve, XYZ, Connector> near = (m, p) => { Connector best = null; double d = double.MaxValue; foreach (Connector c in m.ConnectorManager.Connectors) { var dd = c.Origin.DistanceTo(p); if (dd < d) { d = dd; best = c; } } return best; };
var m1 = (MEPCurve)El(I("main1")); var m2 = (MEPCurve)El(I("main2")); var br = (MEPCurve)El(I("branch"));
Connector a = null, b = null; double dist = double.MaxValue;
foreach (Connector x in m1.ConnectorManager.Connectors) foreach (Connector y in m2.ConnectorManager.Connectors) { var d = x.Origin.DistanceTo(y.Origin); if (d < dist) { dist = d; a = x; b = y; } }
var t = doc.Create.NewTeeFitting(a, b, near(br, a.Origin));
return R("tee", IdOf(t));

@@ revit_mep_split
title: Split pipe / duct at point
host: revit
desc: Break a pipe or duct into two at a point (mm), keeping connections (PlumbingUtils / MechanicalUtils).
arg: id | integer! | Pipe or duct
arg: point | point! | Split point on the element
code:
var e = El(I("id")); ElementId nid;
if (e is Pipe) nid = PlumbingUtils.BreakCurve(doc, e.Id, P("point"));
else if (e is Duct) nid = MechanicalUtils.BreakCurve(doc, e.Id, P("point"));
else { Fail("Only pipes and ducts can be split"); return null; }
return R("newSegment", IdOf(nid));

@@ revit_pipe_size
title: Set pipe diameter / slope
host: revit
desc: Change pipe diameter (mm) and/or slope (e.g. "2%" or 0.02) for pipes.
arg: ids | ids | Pipes (omit = selection)
arg: diameterMm | number | Diameter
arg: slope | number | Slope ratio (0.01 = 1%)
code:
int n = 0;
foreach (var e in Elems("ids")) { var p = e as Pipe; if (p == null) continue;
  if (Has("diameterMm")) p.get_Parameter(BuiltInParameter.RBS_PIPE_DIAMETER_PARAM).Set(Ft(N("diameterMm")));
  if (Has("slope")) { var sp = p.get_Parameter(BuiltInParameter.RBS_PIPE_SLOPE); if (sp != null && !sp.IsReadOnly) sp.Set(N("slope")); }
  n++; }
return R("updated", n);

@@ revit_duct_size
title: Set duct size
host: revit
desc: Change duct width/height or diameter (mm).
arg: ids | ids | Ducts (omit = selection)
arg: widthMm | number | Width
arg: heightMm | number | Height
arg: diameterMm | number | Diameter
code:
int n = 0;
foreach (var e in Elems("ids")) { var d = e as Duct; if (d == null) continue;
  if (Has("widthMm")) { var p = d.get_Parameter(BuiltInParameter.RBS_CURVE_WIDTH_PARAM); if (p != null && !p.IsReadOnly) p.Set(Ft(N("widthMm"))); }
  if (Has("heightMm")) { var p = d.get_Parameter(BuiltInParameter.RBS_CURVE_HEIGHT_PARAM); if (p != null && !p.IsReadOnly) p.Set(Ft(N("heightMm"))); }
  if (Has("diameterMm")) { var p = d.get_Parameter(BuiltInParameter.RBS_CURVE_DIAMETER_PARAM); if (p != null && !p.IsReadOnly) p.Set(Ft(N("diameterMm"))); }
  n++; }
return R("updated", n);

@@ revit_mep_offset
title: Set MEP middle elevation
host: revit
desc: Set the middle elevation / offset (mm above reference level) of pipes, ducts, trays and conduits.
arg: ids | ids | Elements (omit = selection)
arg: offsetMm | number! | Middle elevation above level
code:
int n = 0;
foreach (var e in Elems("ids")) { var p = e.get_Parameter(BuiltInParameter.RBS_OFFSET_PARAM); if (p != null && !p.IsReadOnly) { p.Set(Ft(N("offsetMm"))); n++; } }
return R("updated", n);

@@ revit_insulation_add
title: Add pipe / duct insulation
host: revit
desc: Add insulation (type + thickness mm) to pipes or ducts. Use lining=true for duct lining.
arg: ids | ids | Pipes/ducts (omit = selection)
arg: thicknessMm | number! | Thickness
arg: type | string | Insulation/lining type
arg: lining | boolean | Duct lining instead of insulation
code:
var made = new List<object>(); double t = Ft(N("thicknessMm"));
foreach (var e in Elems("ids"))
{
    try
    {
        if (e is Pipe || e is FlexPipe || e.Category.Id.Equals(new ElementId(BuiltInCategory.OST_PipeFitting)))
        { var it = Col().OfClass(typeof(PipeInsulationType)).FirstOrDefault(x => !Has("type") || x.Name == S("type")); made.Add(IdOf(PipeInsulation.Create(doc, e.Id, it.Id, t))); }
        else if (B("lining"))
        { var lt = Col().OfClass(typeof(DuctLiningType)).FirstOrDefault(x => !Has("type") || x.Name == S("type")); made.Add(IdOf(DuctLining.Create(doc, e.Id, lt.Id, t))); }
        else
        { var it = Col().OfClass(typeof(DuctInsulationType)).FirstOrDefault(x => !Has("type") || x.Name == S("type")); made.Add(IdOf(DuctInsulation.Create(doc, e.Id, it.Id, t))); }
    }
    catch (Exception ex) { Print(IdOf(e) + ": " + ex.Message); }
}
return R("created", made);

@@ revit_mep_open_ends
title: Open connectors (disconnects)
host: revit
tx: false
desc: Every unconnected MEP connector (open pipe/duct ends, unconnected equipment) with location (mm) - like Show Disconnects.
arg: category | string | Limit to a category (Pipes, Ducts, Mechanical Equipment...)
code:
IEnumerable<Element> q = Has("category") ? Col().OfCategoryId(Cat(S("category")).Id).WhereElementIsNotElementType() : Col().WhereElementIsNotElementType().Where(e => e is MEPCurve || e is FamilyInstance);
var list = new List<object>();
foreach (var e in q)
{
    ConnectorManager cm = null;
    var mc = e as MEPCurve; var fi = e as FamilyInstance;
    if (mc != null) cm = mc.ConnectorManager; else if (fi != null && fi.MEPModel != null) cm = fi.MEPModel.ConnectorManager;
    if (cm == null) continue;
    foreach (Connector c in cm.UnusedConnectors) list.Add(R("id", IdOf(e), "category", e.Category == null ? null : e.Category.Name, "domain", c.Domain.ToString(), "at", Out(c.Origin)));
    if (list.Count > 3000) break;
}
return R("open", list.Count, "connectors", list);

@@ revit_mep_connectors
title: Connectors of an element
host: revit
tx: false
desc: All connectors of MEP elements with domain, shape, size, flow direction, system and what they connect to.
arg: ids | ids | Elements (omit = selection)
code:
var res = new List<object>();
foreach (var e in Elems("ids"))
{
    ConnectorManager cm = null; var mc = e as MEPCurve; var fi = e as FamilyInstance;
    if (mc != null) cm = mc.ConnectorManager; else if (fi != null && fi.MEPModel != null) cm = fi.MEPModel.ConnectorManager;
    if (cm == null) continue;
    foreach (Connector c in cm.Connectors)
    {
        var refs = new List<object>(); if (c.IsConnected) foreach (Connector o in c.AllRefs) if (o.Owner.Id != e.Id) refs.Add(IdOf(o.Owner.Id));
        res.Add(R("element", IdOf(e), "id", c.Id, "domain", c.Domain.ToString(), "shape", c.Shape.ToString(), "at", Out(c.Origin),
            "radiusMm", c.Shape == ConnectorProfileType.Round ? Mm(c.Radius) : 0, "connected", c.IsConnected, "to", refs));
    }
}
return res;

@@ revit_mep_equipment_report
title: MEP equipment & fixtures
host: revit
tx: false
desc: Mechanical equipment, plumbing fixtures, air terminals, sprinklers, lighting and electrical fixtures/equipment with type, level, room and system.
code:
var cats = new[] { BuiltInCategory.OST_MechanicalEquipment, BuiltInCategory.OST_PlumbingFixtures, BuiltInCategory.OST_DuctTerminal, BuiltInCategory.OST_Sprinklers, BuiltInCategory.OST_LightingFixtures, BuiltInCategory.OST_ElectricalFixtures, BuiltInCategory.OST_ElectricalEquipment };
var r = new Dictionary<string, object>();
foreach (var c in cats)
  r[c.ToString().Replace("OST_", "")] = OfCat(c).OfType<FamilyInstance>().GroupBy(f => f.Symbol.FamilyName + " : " + f.Symbol.Name).ToDictionary(g => g.Key, g => (object)g.Count());
return r;

@@ revit_fittings_accessories
title: Fittings & accessories count
host: revit
tx: false
desc: Pipe/duct fittings and accessories counted by family/type (BOQ).
code:
var cats = new[] { BuiltInCategory.OST_PipeFitting, BuiltInCategory.OST_PipeAccessory, BuiltInCategory.OST_DuctFitting, BuiltInCategory.OST_DuctAccessory, BuiltInCategory.OST_CableTrayFitting, BuiltInCategory.OST_ConduitFitting };
var r = new Dictionary<string, object>();
foreach (var c in cats) r[c.ToString().Replace("OST_", "")] = OfCat(c).OfType<FamilyInstance>().GroupBy(f => f.Symbol.FamilyName + " : " + f.Symbol.Name).ToDictionary(g => g.Key, g => (object)g.Count());
return r;

