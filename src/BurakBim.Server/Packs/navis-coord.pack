code:
var r = new List<object>();
foreach (SavedItem it in doc.SavedViewpoints.RootItem.Children)
  foreach (Comment c in it.Comments) r.Add(R("on", it.DisplayName, "body", c.Body, "author", c.Author, "status", c.Status.ToString(), "date", c.CreationDate.ToString("s")));
return r;

@@ navis_comment_add
title: Add comment to a viewpoint
host: navisworks
set: navisworks
tx: false
desc: Add a comment (body, status) to a saved viewpoint.
arg: viewpoint | string! | Viewpoint name
arg: body | string! | Comment text
arg: status | string | New, Active, Approved, Resolved (default New)
code:
foreach (SavedItem it in doc.SavedViewpoints.RootItem.Children)
  if (it.DisplayName == S("viewpoint"))
  {
      CommentStatus st; if (!Enum.TryParse(S("status", "New"), true, out st)) st = CommentStatus.New;
      var cc = new CommentCollection(); foreach (Comment c in it.Comments) cc.Add(c); cc.Add(new Comment(S("body"), st, Environment.UserName));
      doc.SavedViewpoints.EditComments(it, cc); return R("added", true);
  }
Fail("Viewpoint not found"); return null;
