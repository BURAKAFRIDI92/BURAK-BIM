        "combinations", All<LoadCombination>().Select(c => (object)R("id", IdOf(c), "name", c.Name, "type", c.Type.ToString(), "state", c.State.ToString())).ToList());

@@ revit_braces_trusses
title: Braces, trusses & connections
host: revit
tx: false
desc: Structural trusses, braces and structural connections in the model.
code:
return R("trusses", All<Truss>().Select(t => (object)R("id", IdOf(t), "type", Name(t.GetTypeId()))).ToList(),
  "braces", OfCat(BuiltInCategory.OST_StructuralFraming).OfType<FamilyInstance>().Where(f => f.StructuralType == StructuralType.Brace).Select(f => (object)IdOf(f)).ToList(),
  "connections", All<StructuralConnectionHandler>().Select(c => (object)R("id", IdOf(c), "type", Name(c.GetTypeId()), "connected", IdList(c.GetConnectedElementIds()))).ToList());

@@ revit_column_grid_check
title: Columns off grid
host: revit
tx: false
desc: Structural columns that are not on a grid intersection (QA), with distance to the nearest grid (mm).
arg: toleranceMm | number | Allowed distance (default 10)
code:
var lines = All<Grid>().Select(g => g.Curve).OfType<Line>().ToList(); var bad = new List<object>(); double tol = Ft(N("toleranceMm", 10));
foreach (var c in OfCat(BuiltInCategory.OST_StructuralColumns))
{
    var p = ((LocationPoint)c.Location).Point;
    var ds = lines.Select(l => l.Distance(new XYZ(p.X, p.Y, l.Origin.Z))).OrderBy(d => d).ToList();
    if (ds.Count < 2 || ds[1] > tol) bad.Add(R("id", IdOf(c), "nearestGridMm", ds.Count == 0 ? -1 : Mm(ds[0]), "secondGridMm", ds.Count < 2 ? -1 : Mm(ds[1])));
}
return R("offGrid", bad.Count, "columns", bad);

@@ revit_framing_types
title: Structural section types
host: revit
tx: false
desc: Loaded column/framing/foundation types with key dimensions.
code:
var cats = new[] { BuiltInCategory.OST_StructuralColumns, BuiltInCategory.OST_StructuralFraming, BuiltInCategory.OST_StructuralFoundation };
var r = new Dictionary<string, object>();
foreach (var c in cats) r[c.ToString().Replace("OST_", "")] = TypesOfCat(c).OfType<FamilySymbol>().Select(s => (object)(s.FamilyName + " : " + s.Name)).ToList();
return r;

@@ revit_slab_edge_check
title: Floors without structural flag
host: revit
tx: false
desc: Floors whose type name suggests structure (slab/RCC) but are not flagged structural, and vice versa.
code:
return All<Floor>().Where(f => { var s = f.get_Parameter(BuiltInParameter.FLOOR_PARAM_IS_STRUCTURAL).AsInteger() == 1; var n = f.FloorType.Name.ToLowerInvariant(); bool looks = n.Contains("slab") || n.Contains("rcc") || n.Contains("concrete") || n.Contains("struct"); return looks != s; })
  .Select(f => (object)R("id", IdOf(f), "type", f.FloorType.Name, "structural", f.get_Parameter(BuiltInParameter.FLOOR_PARAM_IS_STRUCTURAL).AsInteger() == 1)).ToList();
