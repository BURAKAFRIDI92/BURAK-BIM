@@ navis_publish_nwd
title: Publish NWD
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Publish the current document to an NWD (title, author, comments, optional password protection off).
arg: path | string! | Output .nwd path
arg: title | string | Title
arg: author | string | Author
arg: comments | string | Comments
code:
var pp = new PublishProperties { Title = S("title", doc.Title), Author = S("author", "BURAK BIM"), Comments = S("comments", "") };
doc.PublishFile(S("path"), pp);
return R("published", S("path"));
