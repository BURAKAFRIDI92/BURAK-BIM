@@ navis_timeliner_task_dates
title: TimeLiner: edit task dates
host: navisworks
set: navisworks
tx: false
readonly: false
desc: Set planned/actual dates of a TimeLiner task by name.
arg: task | string! | Task name
arg: plannedStart | string | yyyy-MM-dd
arg: plannedEnd | string | yyyy-MM-dd
arg: actualStart | string | yyyy-MM-dd
arg: actualEnd | string | yyyy-MM-dd
code:
var tl = TimelinerDoc(); dynamic found = null;
foreach (dynamic t in tl.TasksRoot.Children) if ((string)t.DisplayName == S("task")) found = t;
if (found == null) Fail("Task not found");
dynamic copy = found.CreateCopy(); var ci = System.Globalization.CultureInfo.InvariantCulture;
if (Has("plannedStart")) copy.PlannedStartDate = DateTime.Parse(S("plannedStart"), ci);
if (Has("plannedEnd")) copy.PlannedEndDate = DateTime.Parse(S("plannedEnd"), ci);
if (Has("actualStart")) copy.ActualStartDate = DateTime.Parse(S("actualStart"), ci);
if (Has("actualEnd")) copy.ActualEndDate = DateTime.Parse(S("actualEnd"), ci);
tl.TaskEdit(found, copy);
return R("updated", S("task"));

@@ navis_timeliner_delays
title: TimeLiner: delayed tasks
host: navisworks
set: navisworks
tx: false
desc: Tasks whose actual end is after the planned end (or not finished past planned end), with delay in days - 4D progress check.
code:
var res = new List<object>(); var stack = new Stack<dynamic>(); stack.Push(TimelinerDoc().TasksRoot);
while (stack.Count > 0)
  foreach (dynamic t in stack.Pop().Children)
  {
      stack.Push(t);
      DateTime? pe = t.PlannedEndDate; DateTime? ae = t.ActualEndDate;
      if (pe == null) continue;
      var end = ae ?? DateTime.Today; var d = (end - pe.Value).TotalDays;
      if (d > 0) res.Add(R("task", (string)t.DisplayName, "plannedEnd", pe.Value.ToString("yyyy-MM-dd"), "actualEnd", ae == null ? null : ae.Value.ToString("yyyy-MM-dd"), "delayDays", Math.Round(d)));
  }
return R("delayed", res.Count, "tasks", res);

@@ navis_comments
title: Comments on viewpoints & clashes
