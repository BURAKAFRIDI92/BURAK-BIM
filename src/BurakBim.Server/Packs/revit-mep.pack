@@ revit_circuit_create
title: Create a power circuit
host: revit
desc: Create a power circuit from electrical fixtures/devices and optionally assign it to a panel.
arg: ids | ids | Fixtures/devices (omit = selection)
arg: panel | string | Panel name
code:
var ids = ElemIds("ids");
var sys = ElectricalSystem.Create(doc, ids, ElectricalSystemType.PowerCircuit);
if (Has("panel"))
{
    var panel = OfCat(BuiltInCategory.OST_ElectricalEquipment).OfType<FamilyInstance>().FirstOrDefault(p => (PrmText(p, "Panel Name") ?? p.Name) == S("panel"));
    if (panel != null) sys.SelectPanel(panel);
}
return R("circuit", IdOf(sys), "number", sys.CircuitNumber);

@@ revit_spaces_report
title: MEP spaces report
host: revit
tx: false
desc: Spaces with number, name, level, area, volume, zone and room association.
code:
return OfCat(BuiltInCategory.OST_MEPSpaces).OfType<Space>().Select(s => (object)R("id", IdOf(s), "number", s.Number, "name", s.Name, "level", s.Level == null ? null : s.Level.Name,
  "areaM2", SqM(s.Area), "volumeM3", CuM(s.Volume), "zone", s.Zone == null ? null : s.Zone.Name, "room", s.Room == null ? null : s.Room.Name)).ToList();

@@ revit_spaces_from_rooms
title: Spaces matching rooms
host: revit
desc: Create an MEP space at every room location (same level) and copy name/number.
arg: level | string | Only this level
code:
var made = new List<object>();
foreach (Room r in OfCat(BuiltInCategory.OST_Rooms).OfType<Room>().Where(r => r.Location != null && r.Area > 0 && (!Has("level") || r.LevelId == LvlArg().Id)))
{
    var p = ((LocationPoint)r.Location).Point;
    var s = doc.Create.NewSpace(r.Level, new UV(p.X, p.Y));
    s.Name = r.Name; s.Number = r.Number; made.Add(IdOf(s));
}
return R("created", made.Count);

@@ revit_hvac_zones
title: HVAC zones
host: revit
tx: false
desc: HVAC zones with their spaces.
code:
return All<Zone>().Select(z => (object)R("id", IdOf(z), "name", z.Name, "spaces", z.Spaces.Size, "areaM2", SqM(z.Area))).ToList();

@@ revit_trays_conduits_report
title: Cable trays & conduits
host: revit
tx: false
desc: Cable trays and conduits with type, size and length; totals by type.
code:
var tr = All<CableTray>().ToList(); var co = All<Conduit>().ToList();
Func<MEPCurve, double> len = m => m.get_Parameter(BuiltInParameter.CURVE_ELEM_LENGTH).AsDouble();
return R("cableTraysM", tr.GroupBy(t => Name(t.GetTypeId())).ToDictionary(g => g.Key, g => (object)Math.Round(g.Sum(len) * 0.3048, 2)),
         "conduitsM", co.GroupBy(c => Name(c.GetTypeId()) + " " + Mm(c.Diameter) + "mm").ToDictionary(g => g.Key, g => (object)Math.Round(g.Sum(len) * 0.3048, 2)));

@@ revit_lights_grid
title: Lighting fixtures in a grid
host: revit
desc: Place lighting fixtures in a regular grid inside a room (spacing mm), at the ceiling height offset.
arg: roomId | integer! | Room
arg: type | string | Lighting fixture type
arg: spacingMm | number | Spacing (default 2400)
arg: heightMm | number | Height above level (default 2700)
code:
var room = El(I("roomId")) as Room; if (room == null) Fail("Not a room");
var sym = TypeByName<FamilySymbol>(S("type"), BuiltInCategory.OST_LightingFixtures); if (!sym.IsActive) { sym.Activate(); doc.Regenerate(); }
var bb = room.get_BoundingBox(null); double s = Ft(N("spacingMm", 2400)); double h = room.Level.Elevation + Ft(N("heightMm", 2700));
var made = new List<object>();
for (double x = bb.Min.X + s / 2; x < bb.Max.X; x += s) for (double y = bb.Min.Y + s / 2; y < bb.Max.Y; y += s)
{
    var p = new XYZ(x, y, room.Level.Elevation + 1);
    if (!room.IsPointInRoom(p)) continue;
    var fi = doc.Create.NewFamilyInstance(new XYZ(x, y, h), sym, room.Level, StructuralType.NonStructural);
    made.Add(IdOf(fi));
}
return R("placed", made.Count, "ids", made);

@@ revit_mep_types
title: MEP type catalogue
host: revit
tx: false
desc: Pipe types, duct types, piping/mechanical system types, cable tray and conduit types available.
code:
return R("pipeTypes", All<PipeType>().Select(t => (object)t.Name).ToList(), "ductTypes", All<DuctType>().Select(t => (object)t.Name).ToList(),
  "pipingSystems", All<PipingSystemType>().Select(t => (object)(t.Name + " (" + t.SystemClassification + ")")).ToList(),
  "mechanicalSystems", All<MechanicalSystemType>().Select(t => (object)(t.Name + " (" + t.SystemClassification + ")")).ToList(),
  "cableTrayTypes", All<CableTrayType>().Select(t => (object)t.Name).ToList(), "conduitTypes", All<ConduitType>().Select(t => (object)t.Name).ToList());

@@ revit_mep_clearance
title: MEP headroom check
host: revit
tx: false
desc: Pipes/ducts/trays whose bottom elevation is below a minimum clearance (mm) above their level - headroom QA.
arg: minClearanceMm | number! | Minimum bottom height above level
code:
var bad = new List<object>(); double min = Ft(N("minClearanceMm"));
foreach (var m in Col().OfClass(typeof(MEPCurve)).Cast<MEPCurve>())
{
    if (m.ReferenceLevel == null) continue;
    var bb = m.get_BoundingBox(null); if (bb == null) continue;
    var clear = bb.Min.Z - m.ReferenceLevel.Elevation;
    if (clear < min) bad.Add(R("id", IdOf(m), "category", m.Category.Name, "level", m.ReferenceLevel.Name, "clearanceMm", Mm(clear)));
}
return R("violations", bad.Count, "elements", bad.Take(1000).ToList());

@@ revit_system_elements
title: Elements of a system
host: revit
tx: false
desc: All elements belonging to an MEP system (by name or id).
arg: system | string! | System name or id
code:
var s = All<MEPSystem>().FirstOrDefault(x => x.Name == S("system") || IdOf(x).ToString() == S("system"));
if (s == null) Fail("System not found");
var list = new List<object>(); foreach (Element e in s.Elements) list.Add(R("id", IdOf(e), "category", e.Category == null ? null : e.Category.Name, "name", e.Name));
return R("system", s.Name, "count", list.Count, "elements", list);

@@ revit_mep_color_by_system
title: Color MEP by system
host: revit
desc: Color pipes/ducts in the active view by system (distinct color per system) - quick coordination view.
code:
var v = doc.ActiveView; var fill = SolidFill(); var palette = new[] { new Color(230, 25, 75), new Color(60, 180, 75), new Color(0, 130, 200), new Color(245, 130, 48), new Color(145, 30, 180), new Color(70, 240, 240), new Color(240, 50, 230), new Color(210, 245, 60), new Color(0, 128, 128), new Color(170, 110, 40) };
var map = new Dictionary<string, object>(); int i = 0;
foreach (var g in Col().OfClass(typeof(MEPCurve)).Cast<MEPCurve>().Where(m => m.MEPSystem != null).GroupBy(m => m.MEPSystem.Name))
{
    var c = palette[i++ % palette.Length]; var o = new OverrideGraphicSettings(); o.SetProjectionLineColor(c);
    if (fill != ElementId.InvalidElementId) { o.SetSurfaceForegroundPatternId(fill); o.SetSurfaceForegroundPatternColor(c); }
    foreach (var m in g) v.SetElementOverrides(m.Id, o);
    map[g.Key] = "#" + c.Red.ToString("X2") + c.Green.ToString("X2") + c.Blue.ToString("X2");
}
return R("view", v.Name, "systems", map);
